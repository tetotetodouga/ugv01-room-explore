<?xml version="1.0"?>
<robot name="ugv01_x3_premium">

  <!-- ================= MATERIALS ================= -->
  <material name="mat_black">
    <color rgba="0.015 0.016 0.020 1.0"/>
  </material>

  <material name="mat_graphite">
    <color rgba="0.055 0.060 0.072 1.0"/>
  </material>

  <material name="mat_dark_plate">
    <color rgba="0.020 0.022 0.028 1.0"/>
  </material>

  <material name="mat_edge">
    <color rgba="0.18 0.19 0.21 1.0"/>
  </material>

  <material name="mat_track">
    <color rgba="0.006 0.007 0.009 1.0"/>
  </material>

  <material name="mat_rubber">
    <color rgba="0.010 0.010 0.012 1.0"/>
  </material>

  <material name="mat_metal">
    <color rgba="0.42 0.43 0.45 1.0"/>
  </material>

  <material name="mat_lidar">
    <color rgba="0.030 0.032 0.040 1.0"/>
  </material>

  <material name="mat_glass">
    <color rgba="0.02 0.08 0.14 1.0"/>
  </material>

  <material name="mat_status">
    <color rgba="0.10 0.20 0.90 1.0"/>
  </material>

  <!-- ================= ROOT FRAMES ================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Main physical collision body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.058" rpy="0 0 0"/>
      <geometry>
        <box size="0.205 0.122 0.070"/>
      </geometry>
      <material name="mat_graphite"/>
    </visual>

    <visual>
      <origin xyz="0.015 0 0.101" rpy="0 0 0"/>
      <geometry>
        <box size="0.168 0.120 0.010"/>
      </geometry>
      <material name="mat_edge"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <box size="0.232 0.197 0.110"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= SIDE ARMOR PLATES ================= -->
  <link name="left_side_armor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.178 0.008 0.066"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>

  <joint name="base_to_left_side_armor" type="fixed">
    <parent link="base_link"/>
    <child link="left_side_armor"/>
    <origin xyz="0.000 0.071 0.060" rpy="0 0 0"/>
  </joint>

  <link name="right_side_armor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.178 0.008 0.066"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>

  <joint name="base_to_right_side_armor" type="fixed">
    <parent link="base_link"/>
    <child link="right_side_armor"/>
    <origin xyz="0.000 -0.071 0.060" rpy="0 0 0"/>
  </joint>

  <!-- decorative side slots -->
  <link name="left_side_slot_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.004 0.006"/>
      </geometry>
      <material name="mat_edge"/>
    </visual>
  </link>
  <joint name="left_side_slot_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_side_slot_1"/>
    <origin xyz="-0.030 0.076 0.060" rpy="0 0 0"/>
  </joint>

  <link name="right_side_slot_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.004 0.006"/>
      </geometry>
      <material name="mat_edge"/>
    </visual>
  </link>
  <joint name="right_side_slot_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_side_slot_1"/>
    <origin xyz="-0.030 -0.076 0.060" rpy="0 0 0"/>
  </joint>

  <!-- ================= TRACKS ================= -->
  <link name="left_track_upper">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.196 0.038 0.020"/>
      </geometry>
      <material name="mat_track"/>
    </visual>
  </link>
  <joint name="base_to_left_track_upper" type="fixed">
    <parent link="base_link"/>
    <child link="left_track_upper"/>
    <origin xyz="0.000 0.098 0.064" rpy="0 0 0"/>
  </joint>

  <link name="right_track_upper">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.196 0.038 0.020"/>
      </geometry>
      <material name="mat_track"/>
    </visual>
  </link>
  <joint name="base_to_right_track_upper" type="fixed">
    <parent link="base_link"/>
    <child link="right_track_upper"/>
    <origin xyz="0.000 -0.098 0.064" rpy="0 0 0"/>
  </joint>

  <link name="left_track_lower">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.218 0.040 0.018"/>
      </geometry>
      <material name="mat_rubber"/>
    </visual>
  </link>
  <joint name="base_to_left_track_lower" type="fixed">
    <parent link="base_link"/>
    <child link="left_track_lower"/>
    <origin xyz="0.000 0.098 0.015" rpy="0 0 0"/>
  </joint>

  <link name="right_track_lower">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.218 0.040 0.018"/>
      </geometry>
      <material name="mat_rubber"/>
    </visual>
  </link>
  <joint name="base_to_right_track_lower" type="fixed">
    <parent link="base_link"/>
    <child link="right_track_lower"/>
    <origin xyz="0.000 -0.098 0.015" rpy="0 0 0"/>
  </joint>

  <!-- front and rear sprockets -->
  <link name="left_front_sprocket">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.040"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="left_front_sprocket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_sprocket"/>
    <origin xyz="0.095 0.098 0.034" rpy="0 0 0"/>
  </joint>

  <link name="right_front_sprocket">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.040"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="right_front_sprocket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_sprocket"/>
    <origin xyz="0.095 -0.098 0.034" rpy="0 0 0"/>
  </joint>

  <link name="left_rear_sprocket">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.040"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="left_rear_sprocket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_rear_sprocket"/>
    <origin xyz="-0.095 0.098 0.034" rpy="0 0 0"/>
  </joint>

  <link name="right_rear_sprocket">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.040"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="right_rear_sprocket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_rear_sprocket"/>
    <origin xyz="-0.095 -0.098 0.034" rpy="0 0 0"/>
  </joint>

  <!-- road wheels -->
  <link name="left_road_wheels">
    <visual>
      <origin xyz="-0.060 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
    <visual>
      <origin xyz="-0.020 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
    <visual>
      <origin xyz="0.020 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
    <visual>
      <origin xyz="0.060 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="left_road_wheels_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_road_wheels"/>
    <origin xyz="0.000 0.098 0.030" rpy="0 0 0"/>
  </joint>

  <link name="right_road_wheels">
    <visual>
      <origin xyz="-0.060 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
    <visual>
      <origin xyz="-0.020 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
    <visual>
      <origin xyz="0.020 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
    <visual>
      <origin xyz="0.060 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.014" length="0.036"/></geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="right_road_wheels_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_road_wheels"/>
    <origin xyz="0.000 -0.098 0.030" rpy="0 0 0"/>
  </joint>

  <!-- tread blocks as grouped visuals -->
  <link name="left_tread_blocks">
    <visual><origin xyz="-0.090 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="-0.066 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="-0.042 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="-0.018 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.006 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.030 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.054 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.078 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.102 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
  </link>
  <joint name="left_tread_blocks_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_tread_blocks"/>
    <origin xyz="0.000 0.098 0.006" rpy="0 0 0"/>
  </joint>

  <link name="right_tread_blocks">
    <visual><origin xyz="-0.090 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="-0.066 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="-0.042 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="-0.018 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.006 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.030 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.054 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.078 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
    <visual><origin xyz="0.102 0 0" rpy="0 0 0"/><geometry><box size="0.012 0.046 0.010"/></geometry><material name="mat_edge"/></visual>
  </link>
  <joint name="right_tread_blocks_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_tread_blocks"/>
    <origin xyz="0.000 -0.098 0.006" rpy="0 0 0"/>
  </joint>

  <!-- ================= TOP PLATFORM ================= -->
  <link name="top_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.162 0.116 0.012"/>
      </geometry>
      <material name="mat_dark_plate"/>
    </visual>
  </link>
  <joint name="base_to_top_plate" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate"/>
    <origin xyz="0.015 0 0.118" rpy="0 0 0"/>
  </joint>

  <link name="top_rail_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.170 0.008 0.012"/>
      </geometry>
      <material name="mat_edge"/>
    </visual>
  </link>
  <joint name="top_rail_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_rail_front"/>
    <origin xyz="0.012 0.064 0.123" rpy="0 0 0"/>
  </joint>

  <link name="top_rail_rear">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.170 0.008 0.012"/>
      </geometry>
      <material name="mat_edge"/>
    </visual>
  </link>
  <joint name="top_rail_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_rail_rear"/>
    <origin xyz="0.012 -0.064 0.123" rpy="0 0 0"/>
  </joint>

  <!-- ================= LD19 / STL-19P LIDAR ================= -->
  <link name="ldlidar_base">
    <visual>
      <origin xyz="0 0 -0.014" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.018"/>
      </geometry>
      <material name="mat_lidar"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.004" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.022"/>
      </geometry>
      <material name="mat_graphite"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.006"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>

  <joint name="base_link_to_ldlidar_base" type="fixed">
    <parent link="base_link"/>
    <child link="ldlidar_base"/>
    <origin xyz="0.045 0.000 0.123" rpy="0 0 1.5708"/>
  </joint>

  <!-- ================= FRONT CAMERA / LIGHTS ================= -->
  <link name="front_sensor_bar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.088 0.026"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>
  <joint name="front_sensor_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_sensor_bar"/>
    <origin xyz="0.117 0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="front_camera_lens">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.013" length="0.010"/>
      </geometry>
      <material name="mat_glass"/>
    </visual>
  </link>
  <joint name="front_camera_lens_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_lens"/>
    <origin xyz="0.131 0.000 0.075" rpy="0 0 0"/>
  </joint>

  <link name="front_left_light">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.008"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="front_left_light_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_light"/>
    <origin xyz="0.131 0.032 0.077" rpy="0 0 0"/>
  </joint>

  <link name="front_right_light">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.008"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="front_right_light_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_light"/>
    <origin xyz="0.131 -0.032 0.077" rpy="0 0 0"/>
  </joint>

  <!-- ================= ANTENNA ================= -->
  <link name="antenna_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.018"/>
      </geometry>
      <material name="mat_metal"/>
    </visual>
  </link>
  <joint name="antenna_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="antenna_base"/>
    <origin xyz="-0.088 0.058 0.126" rpy="0 0 0"/>
  </joint>

  <link name="antenna_whip">
    <visual>
      <origin xyz="0 0 0.078" rpy="0 0.32 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.165"/>
      </geometry>
      <material name="mat_edge"/>
    </visual>
  </link>
  <joint name="antenna_whip_joint" type="fixed">
    <parent link="antenna_base"/>
    <child link="antenna_whip"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <!-- ================= SMALL DETAILS ================= -->
  <link name="status_led">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.006"/>
      </geometry>
      <material name="mat_status"/>
    </visual>
  </link>
  <joint name="status_led_joint" type="fixed">
    <parent link="base_link"/>
    <child link="status_led"/>
    <origin xyz="0.048 0.000 0.156" rpy="0 0 0"/>
  </joint>

</robot>
